{
    "scripts": {
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:jsr": "jsr publish --dry-run",
        "test:doc": "deno doc --html --name=\"@ayaexptech/arcane\" --output=./.docs-preview/ ./mod.ts && deno run -A jsr:@std/http/file-server .docs-preview"
    },
    "devDependencies": {
        "jsr": "^0.14.3",
        "oxfmt": "^0.59.0",
        "oxlint": "^1.74.0",
        "vitest": "^4.1.10"
    }
}
